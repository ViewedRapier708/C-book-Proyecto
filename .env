create table public.autores (
  id bigserial not null,
  nombre text not null,
  constraint autores_pkey primary key (id)
) TABLESPACE pg_default;

create table public.boletas (
  boleta integer not null,
  nombre character varying not null,
  "Grupo" character varying not null,
  constraint pk_boletas primary key (boleta)
) TABLESPACE pg_default;

create table public.computadoras (
  id integer not null,
  procesador character varying(255) not null,
  programas character varying(255) not null,
  carrera character varying(255) not null,
  "Disponible" boolean not null default true,
  estado_de_material boolean not null default true,
  "Observacion" text not null,
  no_inventario bigint not null,
  no_computadora bigint not null,
  constraint pk_computadoras primary key (id)
) TABLESPACE pg_default;

create table public.editoriales (
  id bigserial not null,
  pie_imprenta text not null,
  constraint editoriales_pkey primary key (id)
) TABLESPACE pg_default;

create table public.ejemplares (
  id bigserial not null,
  libro_id bigint not null,
  codigo_barras text null,
  numero_ejemplar text not null,
  anio integer not null,
  estatus_item text not null,
  "Disponibilidad" boolean not null default true,
  coleccion text not null,
  constraint ejemplares_pkey primary key (id),
  constraint ejemplares_codigo_barras_key unique (codigo_barras),
  constraint ejemplares_libro_id_fkey foreign KEY (libro_id) references libros (id) on delete CASCADE
) TABLESPACE pg_default;

create table public.estados_asistencia (
  id serial not null,
  estado character varying(50) not null,
  constraint estados_asistencia_pkey primary key (id),
  constraint estados_asistencia_estado_key unique (estado)
) TABLESPACE pg_default;

create table public.estados_prestamo (
  id serial not null,
  estado character varying(50) not null,
  constraint estados_prestamo_pkey primary key (id),
  constraint estados_prestamo_estado_key unique (estado)
) TABLESPACE pg_default;

create table public.estados_solicitud (
  id serial not null,
  estado character varying(50) not null,
  constraint estados_solicitud_pkey primary key (id),
  constraint estados_solicitud_estado_key unique (estado)
) TABLESPACE pg_default;

create table public.guardarropas (
  id integer not null,
  ocupado boolean null,
  estado boolean null,
  constraint pk_guardarropas primary key (id)
) TABLESPACE pg_default;

create table public.libros (
  id bigserial not null,
  titulo text not null,
  autor_id bigint null,
  editorial_id bigint null,
  clasificacion text null,
  isbn text null,
  tipo_material text null,
  constraint libros_pkey primary key (id),
  constraint libros_autor_id_fkey foreign KEY (autor_id) references autores (id),
  constraint libros_editorial_id_fkey foreign KEY (editorial_id) references editoriales (id)
) TABLESPACE pg_default;

create table public.prestamos_libros (
  id bigserial not null,
  solicitud_id bigint not null,
  estado_prestamo_id integer not null default 1,
  fecha_inicio_prestamo timestamp with time zone null,
  fecha_limite_devolucion timestamp with time zone null,
  fecha_devolucion_real timestamp with time zone null,
  dias_prestamo integer not null default 7,
  multa numeric(10, 2) null default 0.00,
  observaciones text null,
  constraint prestamos_libros_pkey primary key (id),
  constraint prestamos_libros_solicitud_id_key unique (solicitud_id),
  constraint fk_prestamo_estado foreign KEY (estado_prestamo_id) references estados_prestamo (id),
  constraint fk_prestamo_solicitud foreign KEY (solicitud_id) references solicitudes_libros (id) on delete CASCADE,
  constraint chk_fechas_prestamo check (
    (
      (fecha_devolucion_real is null)
      or (fecha_devolucion_real >= fecha_inicio_prestamo)
    )
  )
) TABLESPACE pg_default;

create index IF not exists idx_prestamos_solicitud on public.prestamos_libros using btree (solicitud_id) TABLESPACE pg_default;

create index IF not exists idx_prestamos_estado on public.prestamos_libros using btree (estado_prestamo_id) TABLESPACE pg_default;

create table public.registros_entradas_salidas (
  id integer not null,
  boleta integer null,
  actividad character varying(255) null,
  material_asignado integer null,
  guardarropa_id integer null,
  hora_entrada time without time zone null,
  hora_salida time without time zone null,
  constraint pk_registros_entradas_salidas primary key (id),
  constraint fk_registros_entradas_salidas_boleta foreign KEY (boleta) references boletas (boleta) on update CASCADE on delete CASCADE,
  constraint fk_registros_entradas_salidas_guardarropa_id foreign KEY (guardarropa_id) references guardarropas (id) on update CASCADE on delete CASCADE
) TABLESPACE pg_default;

create table public.restiradores (
  id integer generated by default as identity not null,
  "Disponible" boolean null default true,
  estado_de_material boolean null default true,
  "Observacion" text null default 'N/A'::text,
  no_inventario character varying not null,
  no_restirador integer not null,
  constraint pk_restiradores primary key (id),
  constraint restiradores_id_key unique (id),
  constraint restiradores_no_inventario_key unique (no_inventario)
) TABLESPACE pg_default;
create table public.solicitudes_computadora (
  id bigserial not null,
  usuario_boleta integer not null,
  computadora_id integer not null,
  fecha_solicitud timestamp without time zone not null default now(),
  fecha_limite_llegada timestamp without time zone GENERATED ALWAYS as ((fecha_solicitud + '01:30:00'::interval)) STORED null,
  estado_asistencia_id integer not null,
  constraint solicitudes_computadora_pkey primary key (id),
  constraint fk_solicitudes_computadora_equipo foreign KEY (computadora_id) references computadoras (id),
  constraint solicitudes_computadora_estado_asistencia_id_fkey foreign KEY (estado_asistencia_id) references estados_asistencia (id),
  constraint solicitudes_computadora_usuario_boleta_fkey foreign KEY (usuario_boleta) references usuarios_web_movil (boleta)
) TABLESPACE pg_default;

create trigger tr_actualizar_disponibilidad_computadora
after INSERT on solicitudes_computadora for EACH row
execute FUNCTION actualizar_disponibilidad_computadora ();

create trigger tr_liberar_computadora_por_estado
after
update on solicitudes_computadora for EACH row
execute FUNCTION liberar_computadora_por_estado ();

create table public.solicitudes_libros (
  id bigserial not null,
  ejemplar_id bigint not null,
  usuario_boleta integer not null,
  estado_solicitud_id integer not null,
  fecha_solicitud timestamp with time zone not null default (now() AT TIME ZONE 'utc-6'::text),
  fecha_limite_respuesta timestamp with time zone not null default (
    (now() AT TIME ZONE 'utc-6'::text) + '2 days'::interval
  ),
  fecha_aprobacion timestamp with time zone null,
  fecha_limite_recoleccion timestamp with time zone null,
  motivo_rechazo text null,
  fecha_cancelacion timestamp with time zone null,
  fecha_rechazo timestamp with time zone null,
  intentos_notificacion integer null default 0,
  constraint solicitudes_libros_pkey primary key (id),
  constraint fk_solicitud_libro_ejemplar foreign KEY (ejemplar_id) references ejemplares (id) on delete CASCADE,
  constraint solicitudes_libros_estado_solicitud_id_fkey foreign KEY (estado_solicitud_id) references estados_solicitud (id),
  constraint solicitudes_libros_usuario_boleta_fkey foreign KEY (usuario_boleta) references usuarios_web_movil (boleta)
) TABLESPACE pg_default;

create index IF not exists idx_solicitudes_libros_estado on public.solicitudes_libros using btree (estado_solicitud_id) TABLESPACE pg_default;

create index IF not exists idx_solicitudes_libros_usuario on public.solicitudes_libros using btree (usuario_boleta) TABLESPACE pg_default;

create index IF not exists idx_solicitudes_libros_ejemplar on public.solicitudes_libros using btree (ejemplar_id) TABLESPACE pg_default;

create table public.solicitudes_restirador (
  id bigserial not null,
  usuario_boleta integer not null,
  restirador_id integer not null,
  fecha_solicitud timestamp without time zone not null default (now() AT TIME ZONE 'utc-6'::text),
  fecha_limite_llegada timestamp without time zone GENERATED ALWAYS as ((fecha_solicitud + '01:30:00'::interval)) STORED null,
  estado_asistencia_id integer not null default 1,
  constraint solicitudes_restirador_pkey primary key (id),
  constraint fk_solicitudes_rest_equipo foreign KEY (restirador_id) references restiradores (id),
  constraint solicitudes_restirador_estado_asistencia_id_fkey foreign KEY (estado_asistencia_id) references estados_asistencia (id),
  constraint solicitudes_restirador_usuario_boleta_fkey foreign KEY (usuario_boleta) references usuarios_web_movil (boleta)
) TABLESPACE pg_default;

create trigger tr_actualizar_disponibilidad_restirador
after INSERT on solicitudes_restirador for EACH row
execute FUNCTION actualizar_disponibilidad_restirador ();

create trigger tr_liberar_restirador_por_estado
after
update on solicitudes_restirador for EACH row
execute FUNCTION liberar_restirador_por_estado ();

create table public.usuarios_web_movil (
  id integer generated by default as identity not null,
  boleta integer not null,
  correo character varying(255) not null,
  tiene_documentos boolean null,
  constraint pk_usuarios_web_movil primary key (id),
  constraint usuarios_web_movil_boleta_key unique (boleta),
  constraint usuarios_web_movil_correo_key unique (correo),
  constraint usuarios_web_movil_id_key unique (id),
  constraint fk_usuarios_web_movil_boleta foreign KEY (boleta) references boletas (boleta) on update CASCADE on delete CASCADE
) TABLESPACE pg_default;

create view public.v_solicitudes_alumno as
select
  id,
  tipo,
  recurso_id,
  fecha_solicitud,
  hora_solicitud,
  hora_limite,
  estado,
  registro_id
from
  (
    select
      sc.id,
      'computadora'::text as tipo,
      sc.computadora_id as recurso_id,
      date (sc.fecha_solicitud) as fecha_solicitud,
      to_char(sc.fecha_solicitud, 'HH24:MI'::text) as hora_solicitud,
      to_char(sc.fecha_limite_llegada, 'HH24:MI'::text) as hora_limite,
      sc.estado_asistencia_id as estado,
      sc.usuario_boleta as registro_id
    from
      solicitudes_computadora sc
    union all
    select
      sl.id,
      'libro'::text as tipo,
      sl.ejemplar_id as recurso_id,
      date (sl.fecha_solicitud) as fecha_solicitud,
      to_char(sl.fecha_solicitud, 'HH24:MI'::text) as hora_solicitud,
      to_char(sl.fecha_limite_respuesta, 'HH24:MI'::text) as hora_limite,
      sl.estado_solicitud_id as estado,
      sl.usuario_boleta as registro_id
    from
      solicitudes_libros sl
    union all
    select
      sr.id,
      'restirador'::text as tipo,
      sr.restirador_id as recurso_id,
      date (sr.fecha_solicitud) as fecha_solicitud,
      to_char(sr.fecha_solicitud, 'HH24:MI'::text) as hora_solicitud,
      to_char(sr.fecha_limite_llegada, 'HH24:MI'::text) as hora_limite,
      sr.estado_asistencia_id as estado,
      sr.usuario_boleta as registro_id
    from
      solicitudes_restirador sr
  ) solicitudes_combinadas;