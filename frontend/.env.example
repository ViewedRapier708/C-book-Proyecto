# Desarrollo local:
# Deja VITE_API_URL vacio para que Vite use el proxy configurado en vite.config.js:
# /auth -> http://localhost:3000
VITE_API_URL=

# Produccion Azure:
# Configura esta variable en el hosting del frontend con la URL publica del App Service backend.
# No agregues /auth al final; el cliente lo agrega automaticamente.
# VITE_API_URL=https://<tu-backend>.azurewebsites.net

# Supabase (credenciales del cliente, desde el dashboard de Supabase)
VITE_SUPABASE_URL=https://yondcnkwcekmkovdeaso.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
