# Runtime local
NODE_ENV=development
PORT=3000

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key

# Supabase del modulo de soporte
SUPABASE_SUPORT_URL=https://tu-proyecto-soporte.supabase.co
SUPABASE_SUPORT_KEY=tu_service_role_key_soporte

# Frontend y CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Sesion y recuperacion de contrasena
SESSION_SECRET=cambia_esta_clave_larga
RESET_PASSWORD_SECRET=cambia_esta_otra_clave_larga
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# SMTP para correos transaccionales
# Opcion simple para Gmail/app password:
SMTP_SERVICE=gmail
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM=C-Book System <tu_correo@gmail.com>

# Opcion SMTP generica. Si usas SMTP_HOST, no se usa SMTP_SERVICE.
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Produccion en Azure App Service:
# NODE_ENV=production
# FRONTEND_URL=https://tu-frontend.com
# CORS_ALLOWED_ORIGINS=https://tu-frontend.com
# SESSION_COOKIE_SAME_SITE=none
# SESSION_COOKIE_SECURE=true
# WEBSITE_NODE_DEFAULT_VERSION=~24
